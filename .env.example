# Copy to .env (repo root, gitignored) and fill in. Read by docker-compose.yml.
#   cp .env.example .env

# Shared secret: the backend rejects requests without a matching X-API-Key;
# the plugin sends it. Unset = open/unauthenticated (private LAN only).
IG_API_KEY=<paste: openssl rand -hex 32>

# PUBLIC URLs the plugin (in Grayjay) uses to reach the backend / fetch
# updates. Point these at your LAN IP, VPS domain, or host:port.
IG_API_BASE=http://<host>:8000
IG_SOURCE_URL=http://<host>:8080/InstagramConfig.json

# Password for the noVNC login UI (recommended before exposing it publicly).
VNC_PASS=<pick a password>

# Host-side port overrides - only needed if 8000/8080/6080 are already used on
# this machine. Update IG_API_BASE / IG_SOURCE_URL to match if you change these.
#IG_API_PORT=8000
#IG_PLUGIN_PORT=8080
#IG_VNC_PORT=6080

# Signs the plugin script so Grayjay doesn't show a "missing signature"
# notice. See backend/server/README.md ("Signing the plugin"). Only one of
# these two is needed:
#IG_SIGN_KEY_B64=<base64 -w0 your_key.pem>
# ^ just paste it - no volume needed. OR, mount a key file instead (uncomment
# the plugin volume in docker-compose.yml) and point this at it:
#IG_SIGN_KEY_PATH=/keys/id_rsa
#IG_SIGN_KEY_PASSPHRASE=
