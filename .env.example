# Copy to .env (repo root, gitignored) and fill in. Read by docker-compose.yml.
#   cp .env.example .env

# Shared secret: the backend rejects requests without a matching X-API-Key;
# the plugin sends it. Unset = open/unauthenticated (private LAN only).
IG_API_KEY=<paste: openssl rand -hex 32>

# PUBLIC URLs the plugin (in Grayjay) uses to reach the backend / fetch
# updates. Point these at your LAN IP, VPS domain, or host:port.
IG_API_BASE=http://<host>:8000
IG_SOURCE_URL=http://<host>:8080/InstagramConfig.json

# Password for the noVNC login UI (recommended before exposing it publicly).
VNC_PASS=<pick a password>

# Grayjay's "Login" button on the source opens this noVNC URL, so the
# first-time Instagram login can be done from the phone alone. Defaults to
# IG_API_BASE's host on IG_VNC_PORT (below) - set it only if that's still
# wrong: a separate domain, or TLS terminated in front.
#IG_VNC_BASE=http://<host>:6080

# Remote screen the login browser runs on. The default is landscape; a
# portrait size is much easier to use when logging in from a phone.
#VNC_GEOMETRY=900x1500x24

# Host-side port overrides - only needed if 8000/8080/6080 are already used on
# this machine. Update IG_API_BASE / IG_SOURCE_URL to match if you change these.
#IG_API_PORT=8000
#IG_PLUGIN_PORT=8080
#IG_VNC_PORT=6080

# Response cache (Redis service is wired in automatically). The actual cache
# duration is set per-request from the plugin's "Cache duration" setting;
# these only cap it server-side. CACHE_MAX_TTL = max seconds allowed;
# CACHE_DEFAULT_TTL = TTL when a request sends no header (0 = don't cache).
#CACHE_MAX_TTL=600
#CACHE_DEFAULT_TTL=0

# Outbound request pacing. Instagram flags accounts on BURSTS of requests,
# so the backend leaves a minimum gap (plus jitter) between real Instagram
# calls. The plugin's "Request spacing" setting can only ask for a LARGER
# gap than the floor below - it can never speed the backend up.
#IG_MIN_INTERVAL_FLOOR=1.0     # hard floor, seconds (lower this at your risk)
#IG_MIN_INTERVAL=2.0           # used when the plugin sends no preference
#IG_INTERVAL_JITTER=0.25       # +/- fraction, so spacing isn't machine-regular
# After a 429 or a login wall, pause Instagram calls this long, doubling per
# consecutive hit up to the max. `GET /throttle` shows the current state.
#IG_BACKOFF_BASE=60
#IG_BACKOFF_MAX=900
# Longest a single request may be held open while pacing. If the wait would
# be longer (i.e. we're backing off), the backend answers 429 + Retry-After
# straight away - holding the connection just becomes a client timeout.
#IG_MAX_WAIT=15

# GraphQL persisted-query ids (keyword search, saved collections).
# Instagram retires these whenever it ships a new web build, and the id is
# the same for every account, so a rotation breaks every deployment at once.
# You should NOT need to set these: the backend learns the current ids from
# the live page and relearns them on the first failure. `GET /docids` shows
# what it's using. Set one only to pin an id by hand (that disables
# relearning for that query).
#IG_DOC_ID_SEARCH=
#IG_DOC_ID_SEARCH_PAGE=
#IG_DOC_ID_SAVED=
# How long a learned id is cached (default 14 days), and the minimum gap
# between two discovery passes - each one loads a real Instagram page on
# your account, so don't lower it much.
#IG_DOCID_TTL=1209600
#IG_DOCID_DISCOVERY_COOLDOWN=900

# Signs the plugin script so Grayjay doesn't show a "missing signature"
# notice. See backend/server/README.md ("Signing the plugin"). Only one of
# these two is needed:
#IG_SIGN_KEY_B64=<base64 -w0 your_key.pem>
# ^ just paste it - no volume needed. OR, mount a key file instead (uncomment
# the plugin volume in docker-compose.yml) and point this at it:
#IG_SIGN_KEY_PATH=/keys/id_rsa
#IG_SIGN_KEY_PASSPHRASE=
